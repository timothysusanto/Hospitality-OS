# HospitalityOS — environment configuration
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Load with: node --env-file=.env src/server.js   (Node 20+)
# or use dotenv if you prefer.

# --- Meta / WhatsApp Cloud API ---
# From developers.facebook.com -> your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# A string YOU invent, then enter the same value in the Meta dashboard
# when configuring the webhook (Webhooks -> Verify Token).
WHATSAPP_VERIFY_TOKEN=

# From developers.facebook.com -> your App -> App Settings -> Basic -> App Secret
META_APP_SECRET=

# --- Server ---
PORT=3000

# --- Firebase (build step 2 onward) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. It downloads a .json file — open it in any text editor,
# copy the ENTIRE contents, and paste as a single-line value here (Railway's
# variable editor handles the JSON fine, multi-line and all).
# Leave blank to run on in-memory stores (fine for early testing only —
# data resets every time the server restarts).
FIREBASE_SERVICE_ACCOUNT_JSON=

